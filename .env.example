# Local development only.
# Production must provide a real ACEBET_SECRET_KEY via environment variables or secret files.

ACEBET_ENV=development
ACEBET_ALLOW_INSECURE_DEV_SECRET=true

# Leave this unset for local tutorial mode, or provide a real secret to mirror production behavior.
# ACEBET_SECRET_KEY=replace-with-a-long-random-secret

# Optional override for Docker/Kubernetes-style secret files.
# ACEBET_SECRETS_DIR=/run/secrets

# Optional external production assets. Each configured directory is strict:
# it must contain the named file and startup will not fall back to packaged data.
# ACEBET_MODEL_DIR=/absolute/path/to/models
# ACEBET_DATA_DIR=/absolute/path/to/data
# For older overridden bundles whose metadata has no player-state digest:
# ACEBET_PLAYER_STATS_SHA256=replace-with-expected-64-char-lowercase-sha256

ACEBET_JWT_ALGORITHM=HS256
ACEBET_ACCESS_TOKEN_EXPIRE_MINUTES=30
ACEBET_DEMO_USERNAME=johndoe
# The tutorial password is accepted only in development/test. Production requires
# an explicitly supplied password of at least 12 characters.
# All passwords must fit within bcrypt's 72 UTF-8 byte limit.
ACEBET_DEMO_PASSWORD=secret
ACEBET_LOG_LEVEL=INFO
ACEBET_LOG_FORMAT=pretty
ACEBET_METRICS_ENABLED=true
ACEBET_RATE_LIMITING_ENABLED=true
ACEBET_TOKEN_RATE_LIMIT=5/minute
ACEBET_PREDICTION_RATE_LIMIT=30/minute
ACEBET_TRACING_ENABLED=false
ACEBET_TRACE_EXPORTER=console
ACEBET_SERVICE_NAME=acebet-api

# Optional file destination. When unset, logs go to the console.
# ACEBET_LOG_FILE=info.log

# Optional tracing exporter endpoint when ACEBET_TRACE_EXPORTER=otlp.
# ACEBET_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
